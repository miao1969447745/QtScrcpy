+bool Device::pluginCommand(const QString &action, const QJsonObject &a)
+{
+    if (!m_controller || !m_serverStartSuccess) return false;
+    // Deliberately call Controller directly: plugin input must never broadcast
+    // to GroupController observers or pass through user game key mappings.
+    if (isCameraMode()) {
+        if (action == "camera_torch") m_controller->setCameraTorch(a.value("enabled").toBool());
+        else if (action == "camera_zoom_in") m_controller->cameraZoomIn();
+        else if (action == "camera_zoom_out") m_controller->cameraZoomOut();
+        else return false;
+        return true;
+    }
+    if (action == "screen_power") m_controller->setDisplayPower(a.value("enabled").toBool());
+    else if (action == "power") m_controller->postPower();
+    else if (action == "android_key") m_controller->pluginKeyCombination(a.value("keycode").toInt(), a.value("metastate").toInt());
+    else if (action == "notifications") m_controller->expandNotificationPanel();
+    else if (action == "quick_settings") m_controller->expandSettingsPanel();
+    else if (action == "collapse_panels") m_controller->collapsePanel();
+    else if (action == "rotate") m_controller->rotateDevice();
+    else if (action == "copy") m_controller->copy();
+    else if (action == "cut") m_controller->cut();
+    else if (action == "clipboard_get") m_controller->requestDeviceClipboard();
+    else if (action == "clipboard_set") m_controller->setDeviceClipboardText(a.value("text").toString(), a.value("paste").toBool());
+    else if (action == "clipboard_paste") m_controller->postKeyCode(279);
+    else if (action == "back_or_screen_on") { m_controller->postBackOrScreenOn(true); m_controller->postBackOrScreenOn(false); }
+    else if (action == "resize_display" && m_params.flexDisplay)
+        m_controller->resizeDisplay(QSize(a.value("display_width").toInt(), a.value("display_height").toInt()));
+    else if (action == "scroll") {
+        const QPointF pos(a.value("x").toInt(), a.value("y").toInt());
+        const QWheelEvent event(pos, pos, QPoint(), QPoint(a.value("horizontal").toInt(), a.value("vertical").toInt()),
+                                Qt::NoButton, Qt::NoModifier, Qt::NoScrollPhase, false);
+        // Use image dimensions for both coordinate spaces; no desktop position.
+        m_controller->wheelEvent(&event, QSize(a.value("width").toInt(), a.value("height").toInt()),
+                                QSize(a.value("width").toInt(), a.value("height").toInt()));
+    } else return false;
+    return true;
+}
